# ============================================
# Variables de entorno - CompuTécnicos Docker
# Copia este archivo como .env y ajusta los valores
# ============================================

# ─── App ───
APP_URL=https://computecnicos.duckdns.org

# ─── Puertos ───
APP_PORT=8080
DB_PORT=3306
PMA_PORT=8081

# ─── Base de datos ───
DB_NAME=computecnicos
DB_USER=computecnicos_user
DB_PASS=computecnicos_secret
MYSQL_ROOT_PASSWORD=root_secret

# ─── PayPal (Sandbox) ───
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_ENVIRONMENT=sandbox

# ─── Facturación Electrónica ───
FE_PROVIDER=alegra
FE_SIMULATE=true
ALEGRA_TOKEN=
ALEGRA_EMAIL=
SIIGO_CLIENT_ID=
SIIGO_CLIENT_SECRET=
SIIGO_USERNAME=
SIIGO_PASSWORD=

# ─── Google OAuth ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Brevo (SendinBlue) Email API ───
BREVO_API_KEY=tu_api_key_de_brevo_aqui
BREVO_SENDER_EMAIL=soportecomputecnicos@yahoo.com
BREVO_SENDER_NAME=CompuTécnicos
BREVO_CONTACT_EMAIL=soportecomputecnicos@yahoo.com

# ─── Abstract Email Reputation API ───
ABSTRACT_EMAIL_API_KEY=tu_api_key_aqui
